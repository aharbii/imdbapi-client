# =============================================================================
# imdbapi-client — environment template
#
# Copy this file to \`.env\` before running any \`make ...\` target.
#
# The core client and test suite require no mandatory environment variables:
# - imdbapi.dev is public by default
# - base URL and API key overrides are passed explicitly to IMDBAPIClient(...)
#
# Never commit \`.env\` to version control.
# =============================================================================


# =============================================================================
# LLM APIs — optional AI agent integrations
#
# Used only by \`examples/langchain_agent_example.py\`.
# =============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=


# =============================================================================
# Observability — LangSmith tracing (optional)
#
# Standardized contract from \`movie-finder-backend\`:
#   - \`LANGSMITH_TRACING\`   enable\/disable tracing (true | false)
#   - \`LANGSMITH_ENDPOINT\`  LangSmith API endpoint
#   - \`LANGSMITH_API_KEY\`   LangSmith project API key
#   - \`LANGSMITH_PROJECT\`   LangSmith project name
# =============================================================================
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=imdbapi-client
