{
  "version": "0.2.0",
  "configurations": [
    // ── Attach to the running editor container first ──────────────────────
    // Start it with `make editor-up`, then use:
    //   Dev Containers: Attach to Running Container...
    {
      "name": "imdbapi: run main.py (container)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "envFile": "${workspaceFolder}/.env",
      "python": "/opt/venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },

    // ── pytest ──────────────────────────────────────────────────────────────
    {
      "name": "pytest: all tests (imdbapi container)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "--asyncio-mode=auto", "-v"],
      "envFile": "${workspaceFolder}/.env",
      "python": "/opt/venv/bin/python",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "pytest: current file (imdbapi container)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "--asyncio-mode=auto", "-v"],
      "envFile": "${workspaceFolder}/.env",
      "python": "/opt/venv/bin/python",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
